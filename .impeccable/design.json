  "narrative": {
    "northStar": "A bold scientific atlas of connections",
    "overview": "Saturated orange, sunny yellow and warm black make the scientific atlas direct and unmistakable. Heavy headlines and mathematical contours connect data, software and physical making.\n\nWarm paper supports longer reading. Angular panels, fine rules and generous space organize verified work. Supporting serif italics retain a human editorial voice.",
    "keyCharacteristics": [
      "Saturated orange and yellow with warm black and paper.",
      "Heavy Manrope headlines and selective serif italic emphasis.",
      "Angular content panels, fine rules and compact rounded controls.",
      "Asymmetric desktop compositions that stack cleanly on mobile.",
      "Mathematical imagery with user-controlled motion."
    ],
    "rules": [
      {
        "name": "The Warm Identity Rule",
        "body": "Build the identity from orange, yellow, warm black and paper; keep supporting tones within the same warm family.",
        "section": "colors"
      },
      {
        "name": "The Strong Voice Rule",
        "body": "Keep the hero and contact statement in heavy upright Manrope; reserve serif italics for supporting editorial moments.",
        "section": "typography"
      },
      {
        "name": "The Reading First Rule",
        "body": "Stack complex compositions on narrow screens and let scientific titles wrap naturally.",
        "section": "layout"
      },
      {
        "name": "The Motion Has Controls Rule",
        "body": "Preserve pause controls, reduced-motion behavior and keyboard-visible focus when extending animated surfaces.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use saturated orange and yellow as defining identity fields.",
      "Do check hero text and artwork separation in Italian and English.",
      "Do keep long research titles readable and allow them to wrap.",
      "Do preserve local fonts, inline SVG icons, visible focus and motion controls."
    ],
    "donts": [
      "Don't replace the warm identity with unrelated hues.",
      "Don't introduce shadows into the flat panel vocabulary.",
      "Don't use serif italics for the hero, contact statement, navigation or long body copy.",
      "Don't present illustrative diagrams as live measurements."
    ]
  }
