  "narrative": {
    "northStar": "A scientific atlas of connections",
    "overview": "Warm paper and forest ink make technical work approachable. Large typography, generous empty space and contour geometry connect research, software and physical making.\n\nThe system is editorial and precise. A restrained italic voice adds personality while Manrope keeps navigation, reading and interaction clear.",
    "keyCharacteristics": [
      "Warm paper with forest ink and selective mineral accents.",
      "Large asymmetric compositions balanced by hairline rules.",
      "Manrope structure with Instrument Serif italic emphasis.",
      "Flat tonal panels and readable, compact controls.",
      "Mathematical imagery with user-controlled motion."
    ],
    "rules": [
      {
        "name": "The Ground and Contrast Rule",
        "body": "Keep paper and ink as the structural pair; use lime and terracotta to mark emphasis and interaction.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Manrope for structure and reading; use Instrument Serif italic for short, meaningful emphasis.",
        "section": "typography"
      },
      {
        "name": "The Reading First Rule",
        "body": "Stack complex compositions on narrow screens and let scientific titles wrap naturally.",
        "section": "layout"
      },
      {
        "name": "The Motion Has Controls Rule",
        "body": "Preserve pause controls, reduced-motion behavior and keyboard-visible focus when extending animated surfaces.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use paper and ink to organize the page before adding accents.",
      "Do keep long research titles readable and allow them to wrap.",
      "Do use local fonts and inline SVG icons.",
      "Do preserve visible focus and user control of motion."
    ],
    "donts": [
      "Don't introduce shadows into the existing flat panel vocabulary.",
      "Don't use Instrument Serif for navigation or long body copy.",
      "Don't present illustrative diagrams as live measurements."
    ]
  }
